# Names only — copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server only, never NEXT_PUBLIC_. Needed for posts, paper trading, alerts,
# predictions, communities and the shared AI rate limit.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Market data ---
# Indian stocks, indices, IPOs, movers and MCX commodities (required).
UPSTOX_ACCESS_TOKEN=YOUR_UPSTOX_ACCESS_TOKEN
# US quotes (free plan: 8 credits/min) and fallback (free plan: 25/day).
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
# Earnings calendar, US news and US industries.
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# --- StockSphere AI (at least one) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional overrides: GROQ_MODEL, GROQ_FALLBACK_MODEL, GEMINI_MODEL, LLM_PROVIDERS

# --- Scheduled jobs (required in production) ---
# Any long random string; Vercel Cron sends it as "Authorization: Bearer ...".
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=YOUR_RANDOM_SECRET

# --- Sign-in return address ---
# Not read any more: Google sign-in always returns to the origin it started
# on, because PKCE can only finish there. Remove NEXT_PUBLIC_SITE_URL from
# Vercel; what matters is Supabase Auth > URL Configuration (Site URL and
# Redirect URLs).
